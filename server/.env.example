# copy this file to .env and fill it in (.env is gitignored, never commit it)

# local Postgres, e.g. a database made with: createdb playlist_db
DATABASE_URL=postgres://YOUR_USER@localhost:5432/playlist_db

# port the API listens on (default 3000)
PORT=3000

# extra origin allowed by CORS, e.g. your deployed frontend
# FRONTEND_URL=https://your-app.vercel.app

# optional: YouTube Data API v3 key, lets the app find a full-length video for each song.
# Without it you can still paste a YouTube link on a song (Edit). See the README.
# YOUTUBE_API_KEY=
